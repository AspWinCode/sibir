# Postgres (docker-compose default)
DATABASE_URL="postgresql://sibir:sibir@localhost:5432/sibir?schema=public"

PORT=4000
JWT_SECRET="dev-secret-change-me"

# --- External integrations (leave empty to use local dev fallbacks) ---
# Google Maps JS/Directions API key. Empty => web-app falls back to a static map placeholder.
GOOGLE_MAPS_API_KEY=

# SMS provider (e.g. sms.ru / smsaero). Empty => auth code is printed to server console/log instead of sent.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=

# Dadata (address suggestions). Empty => address fields fall back to plain text input.
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Payment provider - stubbed for now (PaymentProvider interface in src/lib/payment.ts).
PAYMENT_PROVIDER=stub
